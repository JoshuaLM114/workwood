#!/usr/bin/env bash
# Example CHILD script — lives in a component repo at .workwood/up.
#
# A plugin runs it (or a plugin-specific sibling like .workwood/tmux) once per
# context row, handing it the repo's resolved context via env:
#
#   WORKWOOD_REPO     this repo's name
#   WORKWOOD_TARGET   main | worktree | <your-own-target>   (where workwood sourced it)
#   WORKWOOD_DIR      absolute source dir (the worktree, or the base clone)
#   WORKWOOD_BRANCH   the feature branch for this repo (may be empty)
#
# Honour $WORKWOOD_TARGET so the same child works for local code or a custom
# target your team defines (e.g. "deploy").
set -euo pipefail
cd "${WORKWOOD_DIR:?}"

case "${WORKWOOD_TARGET:-worktree}" in
    worktree|main)
        echo "[$WORKWOOD_REPO] starting locally from $WORKWOOD_DIR (branch ${WORKWOOD_BRANCH:-?})"
        # exec your dev server here, e.g.:  exec docker compose up
        ;;
    *)
        echo "[$WORKWOOD_REPO] custom target '$WORKWOOD_TARGET' — do whatever it means here"
        # e.g. port-forward to a deployed instance, point at a remote URL, …
        ;;
esac
