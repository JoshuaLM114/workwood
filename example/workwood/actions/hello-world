#!/usr/bin/env bash
# workwood-action: print each target's .workwood/hello-world.txt
# workwood SOURCES this file and calls one function: Validate or Run.
#
# Validate marks the action AVAILABLE only when at least one selected target
# actually has its .workwood/hello-world.txt — i.e. "the child file is present, so
# the target is targettable". Seed those files first with the standalone helper at
# the project root:
#     ./seed-hello-world.sh <path-to-the-feature's-worktrees>
set -euo pipefail

# Validate: available iff at least one target has a hello-world.txt to print.
Validate() {
    while IFS= read -r line; do
        key=${line%%:*}
        path=${line#*: }
        [ -n "$key" ] && [ "$key" != "$line" ] || continue
        [ -f "$path/.workwood/hello-world.txt" ] && return 0
    done < "${WORKWOOD_TARGETS:?}"
    return 1
}

# Init: create the minimal file this action needs — .workwood/hello-world.txt — in
# every currently-selected target. Idempotent: an existing file is left untouched.
Init() {
    while IFS= read -r line; do
        key=${line%%:*}
        path=${line#*: }
        [ -n "$key" ] && [ "$key" != "$line" ] || continue
        file="$path/.workwood/hello-world.txt"
        if [ -f "$file" ]; then
            echo "exists:  $file"
        else
            mkdir -p "$path/.workwood"
            printf 'Hello, world! 👋  (%s)\n' "$key" > "$file"
            echo "created: $file"
        fi
    done < "${WORKWOOD_TARGETS:?}"
}

# Run: print each target's hello-world.txt, then pause so the output stays
# readable when launched from the TUI (which restores its screen on exit).
Run() {
    while IFS= read -r line; do
        key=${line%%:*}
        path=${line#*: }
        [ -n "$key" ] && [ "$key" != "$line" ] || continue
        file="$path/.workwood/hello-world.txt"
        echo "== $key ($path) =="
        if [ -f "$file" ]; then
            cat "$file"
        else
            echo "(no $file — run ./seed-hello-world.sh on this feature's worktrees)"
        fi
    done < "$WORKWOOD_TARGETS"

    echo
    printf 'Program finished — press Enter to return to workwood… '
    read -r _ < /dev/tty 2>/dev/null || true
    echo
}
