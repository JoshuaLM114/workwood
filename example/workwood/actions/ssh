#!/usr/bin/env bash
# workwood-action: open a shell in a target
# DEFAULT workwood ACTION — ssh. Pick one of the feature's selected targets and
# drop into a shell there. Replace the final shell with your real connect command
# (ssh, kubectl exec, port-forward) keyed off the target's path or a file in it —
# workwood only hands you the paths; what "connect" means is up to you.
#
#   workwood action ssh <feature>
set -euo pipefail
: "${WORKWOOD_TARGETS:?run via: workwood action ssh <feature>}"

keys=(); paths=()
while IFS= read -r line; do
    key=${line%%:*}
    path=${line#*: }
    [ -n "$key" ] && [ "$key" != "$line" ] || continue
    keys+=("$key"); paths+=("$path")
done < "$WORKWOOD_TARGETS"

[ "${#keys[@]}" -gt 0 ] || { echo "no targets selected for ${WORKWOOD_FEATURE:-?}" >&2; exit 1; }

idx=0
if [ "${#keys[@]}" -gt 1 ]; then
    echo "Which target in '${WORKWOOD_FEATURE:-?}'?  (choose 'cancel' to back out)"
    PS3="> "
    select choice in "${keys[@]}" "cancel"; do
        [ -n "${choice:-}" ] || { echo "pick a number" >&2; continue; }
        [ "$choice" = "cancel" ] && { echo "cancelled"; exit 0; }
        idx=$((REPLY - 1)); break
    done
fi

target="${keys[$idx]}"; dir="${paths[$idx]}"
echo "== $target ($dir) =="
cd "$dir"
exec "${SHELL:-/bin/bash}"
