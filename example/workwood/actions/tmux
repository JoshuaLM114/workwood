#!/usr/bin/env bash
# workwood-action: one tmux window per target
# DEFAULT workwood ACTION — tmux. workwood SOURCES this file and calls Validate or
# Run. Run boots a tmux session with one window per selected target, cd'd into its
# path; the session is named after the active super-feature.
set -euo pipefail

# Validate: available when tmux is installed and there are targets.
Validate() {
    command -v tmux >/dev/null 2>&1 || return 1
    [ -s "${WORKWOOD_TARGETS:-}" ]
}

# Run: one tmux window per "key: path" target.
Run() {
    command -v tmux >/dev/null 2>&1 || { echo "ERROR: tmux is not installed" >&2; return 1; }
    local SESSION="${WORKWOOD_FEATURE:-workwood}"

    tmux has-session -t "$SESSION" 2>/dev/null && tmux kill-session -t "$SESSION"
    tmux new-session -d -s "$SESSION" -n base
    tmux set -g pane-border-status top
    tmux set -g pane-border-format ' #{pane_title} '

    while IFS= read -r line; do
        key=${line%%:*}
        path=${line#*: }
        [ -n "$key" ] && [ "$key" != "$line" ] || continue
        [ -d "$path" ] || continue
        tmux new-window -t "$SESSION" -n "$key" -c "$path"
        P=$(tmux display-message -p -t "$SESSION:$key" '#{pane_id}')
        tmux select-pane -t "$P" -T "$key"
    done < "$WORKWOOD_TARGETS"

    tmux select-window -t "$SESSION:base"
    exec tmux attach -t "$SESSION"
}
