#!/usr/bin/env bash
# DEFAULT workwood PLUGIN — tmux.  Run via:  workwood compose tmux <feature>
#
# Boots a super-feature in ONE tmux session: one window ("tab") per context row,
# each running that repo's CHILD script from its .workwood/ folder. tmux is this
# plugin's choice only — copy this script and write your own for any workflow.
#
#   workwood compose tmux <feature>           → build + attach the session
#   workwood compose tmux <feature> --init     → scaffold each repo's .workwood child
#
# Context env:  WORKWOOD_PLUGIN, WORKWOOD_MODE, WORKWOOD_SESSION, WORKWOOD_CONTEXT,
#               WORKWOOD_LANG (active UI language — localize your own output if you like)
# TSV columns:  repo <TAB> target <TAB> dir <TAB> workwood <TAB> branch
set -euo pipefail

: "${WORKWOOD_CONTEXT:?run via: workwood compose tmux <feature>}"
SESSION="${WORKWOOD_SESSION:-workwood}"
PLUGIN="${WORKWOOD_PLUGIN:-tmux}"
MODE="${WORKWOOD_MODE:-run}"

if [ "$MODE" = init ]; then
    # The init UTILITY: scaffold a starter child into each repo's .workwood/.
    while IFS=$'\t' read -r repo target dir workwood branch; do
        [ -n "$repo" ] || continue
        mkdir -p "$workwood"
        child="$workwood/$PLUGIN"
        if [ -e "$child" ]; then echo "exists:  $child"; continue; fi
        cat > "$child" <<'CHILD'
#!/usr/bin/env bash
# .workwood/tmux child — boots this repo's piece for a tmux window.
# Honour $WORKWOOD_TARGET (worktree | main | <custom>). Env in: WORKWOOD_REPO,
# WORKWOOD_TARGET, WORKWOOD_DIR, WORKWOOD_BRANCH.
set -euo pipefail
cd "${WORKWOOD_DIR:-.}"
echo "[$WORKWOOD_REPO] target=$WORKWOOD_TARGET branch=${WORKWOOD_BRANCH:-?}"
# Replace with your dev server, e.g.:  exec docker compose up
exec "${SHELL:-/bin/bash}"
CHILD
        chmod +x "$child"
        echo "created: $child"
    done < "$WORKWOOD_CONTEXT"
    exit 0
fi

command -v tmux >/dev/null 2>&1 || { echo "ERROR: tmux is not installed" >&2; exit 1; }

tmux has-session -t "$SESSION" 2>/dev/null && tmux kill-session -t "$SESSION"
tmux new-session -d -s "$SESSION" -n base
tmux set -g pane-border-status top
tmux set -g pane-border-format ' #{pane_title} '

# One window per context row; each runs that repo's child with the target.
n=0
while IFS=$'\t' read -r repo target dir workwood branch; do
    [ -n "$repo" ] || continue
    n=$((n + 1))

    # Pick a child: a plugin-specific one (.workwood/tmux), else the generic up.
    child=""
    for cand in "$workwood/$PLUGIN" "$workwood/up"; do
        [ -x "$cand" ] && { child="$cand"; break; }
    done

    win="$repo-$n"   # repos can repeat (multiple setups), so suffix the index
    tmux new-window -t "$SESSION" -n "$win" -c "$dir"
    P=$(tmux display-message -p -t "$SESSION:$win" '#{pane_id}')
    tmux select-pane -t "$P" -T "$repo ($target)"
    if [ -n "$child" ]; then
        tmux send-keys -t "$P" \
            "WORKWOOD_REPO='$repo' WORKWOOD_TARGET='$target' WORKWOOD_DIR='$dir' WORKWOOD_BRANCH='$branch' '$child'" Enter
    else
        tmux send-keys -t "$P" \
            "echo 'no child in $workwood (looked for: $PLUGIN, up) — try: workwood compose $PLUGIN <feature> --init'" Enter
    fi
done < "$WORKWOOD_CONTEXT"

tmux select-window -t "$SESSION:base"
exec tmux attach -t "$SESSION"
