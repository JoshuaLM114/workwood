#!/usr/bin/env bash
# DEFAULT workwood PLUGIN — helloworld. The simplest possible plugin: it shows how
# a PARENT script composes the output of per-repo CHILD scripts.
#
#   workwood compose helloworld <feature>           → prints "hello world" per repo
#   workwood compose helloworld <feature> --init     → scaffolds each repo's child
#
# Context env: WORKWOOD_PLUGIN, WORKWOOD_MODE, WORKWOOD_FEATURE, WORKWOOD_CONTEXT,
#              WORKWOOD_LANG (active UI language — localize your own output if you like)
# TSV columns:  repo <TAB> target <TAB> dir <TAB> workwood <TAB> branch
set -euo pipefail

: "${WORKWOOD_CONTEXT:?run via: workwood compose helloworld <feature>}"
PLUGIN="${WORKWOOD_PLUGIN:-helloworld}"
MODE="${WORKWOOD_MODE:-run}"

if [ "$MODE" = init ]; then
    # The init UTILITY: scaffold this plugin's child into each repo's .workwood/.
    while IFS=$'\t' read -r repo target dir workwood branch; do
        [ -n "$repo" ] || continue
        mkdir -p "$workwood"
        child="$workwood/$PLUGIN"
        if [ -e "$child" ]; then echo "exists:  $child"; continue; fi
        cat > "$child" <<'CHILD'
#!/usr/bin/env bash
# .workwood/helloworld child — prints the second half of the line.
echo "world"
CHILD
        chmod +x "$child"
        echo "created: $child"
    done < "$WORKWOOD_CONTEXT"
    exit 0
fi

# Run: the PARENT prints "hello ", each CHILD prints "world" → "hello world" per
# repo. Run once per context row (so a repo with multiple target setups repeats).
while IFS=$'\t' read -r repo target dir workwood branch; do
    [ -n "$repo" ] || continue
    child="$workwood/$PLUGIN"
    printf 'hello '
    if [ -x "$child" ]; then
        "$child"
    else
        echo "(no child for $repo — run: workwood compose $PLUGIN ${WORKWOOD_FEATURE:-<feature>} --init)"
    fi
done < "$WORKWOOD_CONTEXT"
