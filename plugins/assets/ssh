#!/usr/bin/env bash
# DEFAULT workwood PLUGIN — ssh.  Run via:  workwood compose ssh <feature>
#
# Jump into a dev service a feature spans, without remembering hosts or
# port-forward incantations. workwood doesn't know how to reach any service —
# each repo ships that knowledge in its own .workwood/ssh CHILD (open a shell,
# kubectl exec, port-forward, plain ssh — whatever it needs). This plugin lists
# the repos that provide one and runs the one you pick.
#
#   workwood compose ssh <feature>            → choose a service and connect
#   workwood compose ssh <feature> --init      → scaffold each repo's .workwood/ssh
#
# Context env:  WORKWOOD_PLUGIN, WORKWOOD_MODE, WORKWOOD_FEATURE, WORKWOOD_CONTEXT,
#               WORKWOOD_LANG (active UI language — localize your own output if you like)
# TSV columns:  repo <TAB> target <TAB> dir <TAB> workwood <TAB> branch
set -euo pipefail

: "${WORKWOOD_CONTEXT:?run via: workwood compose ssh <feature>}"
PLUGIN="${WORKWOOD_PLUGIN:-ssh}"
MODE="${WORKWOOD_MODE:-run}"

if [ "$MODE" = init ]; then
    while IFS=$'\t' read -r repo target dir workwood branch; do
        [ -n "$repo" ] || continue
        mkdir -p "$workwood"
        child="$workwood/$PLUGIN"
        if [ -e "$child" ]; then echo "exists:  $child"; continue; fi
        cat > "$child" <<'CHILD'
#!/usr/bin/env bash
# .workwood/ssh child — connect to THIS repo's dev-deployed service.
# Pick a form and `exec` it. Env in: WORKWOOD_REPO, WORKWOOD_TARGET, WORKWOOD_DIR.
set -euo pipefail
# exec ssh -t "dev@${WORKWOOD_REPO}.dev.example.com"
# pod="$(kubectl -n dev get pod -l app="$WORKWOOD_REPO" -o name | head -n1)"
# exec kubectl -n dev exec -it "$pod" -- /bin/sh
echo "edit $0 to define how to reach $WORKWOOD_REPO's dev service" >&2
exit 1
CHILD
        chmod +x "$child"
        echo "created: $child"
    done < "$WORKWOOD_CONTEXT"
    exit 0
fi

# Collect repos that ship a .workwood/ssh child.
repos=(); children=(); tgts=(); dirs=(); branches=()
while IFS=$'\t' read -r repo target dir workwood branch; do
    [ -n "$repo" ] || continue
    child="$workwood/ssh"
    [ -x "$child" ] || continue
    repos+=("$repo"); children+=("$child"); tgts+=("$target"); dirs+=("$dir"); branches+=("$branch")
done < "$WORKWOOD_CONTEXT"

if [ "${#repos[@]}" -eq 0 ]; then
    echo "No repo in '$WORKWOOD_FEATURE' provides a .workwood/ssh child." >&2
    echo "Scaffold them with:  workwood compose $PLUGIN $WORKWOOD_FEATURE --init" >&2
    exit 1
fi

idx=0
if [ "${#repos[@]}" -gt 1 ]; then
    echo "Which service in '$WORKWOOD_FEATURE'?  (choose 'cancel' to back out)"
    PS3="> "
    select choice in "${repos[@]}" "cancel"; do
        [ -n "${choice:-}" ] || { echo "pick a number" >&2; continue; }
        [ "$choice" = "cancel" ] && { echo "cancelled"; exit 0; }
        idx=$((REPLY - 1)); break
    done
fi

repo="${repos[$idx]}"; child="${children[$idx]}"
echo "== ssh: $repo (${tgts[$idx]}) =="
exec env \
    WORKWOOD_REPO="$repo" \
    WORKWOOD_TARGET="${tgts[$idx]}" \
    WORKWOOD_DIR="${dirs[$idx]}" \
    WORKWOOD_BRANCH="${branches[$idx]}" \
    "$child"
